<Project Sdk="Meziantou.NET.Sdk.Test">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <IncludeSharedHttpClient>true</IncludeSharedHttpClient>
    <SharedHttpClientUserAgent>meziantou-renovate-config-tests</SharedHttpClientUserAgent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Meziantou.Framework.ProcessWrapper" Version="2.0.13" />
    <PackageReference Include="Meziantou.Framework.InlineSnapshotTesting" Version="6.0.23" />
    <PackageReference Include="Meziantou.Framework.Markdown" Version="1.0.9" />
    <PackageReference Include="Meziantou.Framework.TemporaryDirectory" Version="3.0.17" />
  </ItemGroup>
</Project>
